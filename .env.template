# Optional runtime configuration for yt-whisper.
# Copy to .env and adjust. This skill needs NO secrets; never commit real tokens.

# Where transcripts are written (default: ~/Transcriptions)
# OUTPUT_DIR=/home/you/Transcriptions

# Force a Whisper model (base|small|medium|large|turbo) instead of auto-selection
# WHISPER_MODEL=

# Whisper device (default: cuda)
# WHISPER_DEVICE=cuda

# Force a JavaScript runtime for yt-dlp, e.g. node:/usr/bin/node
# YT_JS_RUNTIME=
